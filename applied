#!/usr/bin/env bash
# Thin shim for ./applied from the repo. Prefer the installed command after
# `./install-applied.sh` (or `pip install -e .`).
ROOT="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$ROOT/.venv/bin/applied" ]; then
  exec "$ROOT/.venv/bin/applied" "$@"
fi
if [ -x "$ROOT/.venv/bin/python" ]; then
  PYTHONPATH="$ROOT/src" exec "$ROOT/.venv/bin/python" -m job_tracker.cli "$@"
fi
PYTHONPATH="$ROOT/src" exec python3 -m job_tracker.cli "$@"
